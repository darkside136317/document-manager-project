# Document Manager — production environment
# Copy to .env.prod and run Compose with --env-file .env.prod.
# Keep this file private (chmod 600) and never commit it.

ERPNEXT_VERSION=v16.26.2
COMPOSE_PROJECT_NAME=docmanager_customer

# Use the exact hostname the customer registered in DNS, e.g. hoso.abc.com.vn.
# This is also the Frappe site name. Choose it before the first installation.
FRAPPE_SITE_NAME=hoso.example.com
PUBLIC_URL=https://hoso.example.com

# Unique per customer deployment on this Docker host; no spaces or periods.
DATA_VOLUME_PREFIX=docmanager_customer

# Generate each secret independently. Do not reuse the development credentials.
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
MARIADB_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
MEILISEARCH_MASTER_KEY=REPLACE_WITH_A_RANDOM_SECRET

DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
MEILISEARCH_HOST=http://meilisearch:7700

# Optional GridFS. Leave empty to keep files in Frappe's private site volume.
MONGODB_ATLAS_URI=
MONGODB_DATABASE=docmanager_files

GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Host reverse proxy terminates HTTPS and connects here locally.
HTTP_PUBLISH_PORT=127.0.0.1:8080
CLIENT_MAX_BODY_SIZE=200m
PROXY_READ_TIMEOUT=120
