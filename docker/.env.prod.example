# Document Manager — production environment
# Copy to .env.prod and run Compose with --env-file .env.prod.
# Keep this file private (chmod 600) and never commit it.

ERPNEXT_VERSION=v16.26.2
COMPOSE_PROJECT_NAME=docmanager_customer

# Use the exact hostname the customer registered in DNS, e.g. hoso.abc.com.vn.
# This is also the Frappe site name. Choose it before the first installation.
FRAPPE_SITE_NAME=hoso.example.com
PUBLIC_URL=https://hoso.example.com

# Unique per customer deployment on this Docker host; no spaces or periods.
DATA_VOLUME_PREFIX=docmanager_customer

# Generate each secret independently. Do not reuse the development credentials.
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
MARIADB_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
MEILISEARCH_MASTER_KEY=REPLACE_WITH_A_RANDOM_SECRET

DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# PDFluent service endpoint and separate secrets for both directions.
# Same server: http://host.docker.internal:8000 (PDFluent must listen on the
# Docker host gateway and the port must be restricted by the server firewall).
# Separate server: use its private-network or HTTPS URL.
PDFLUENT_API_URL=
# Match PDFLUENT_API_KEY with PDFluent ERP_INTEGRATION_API_KEY (sk_live_...)
PDFLUENT_API_KEY=
# Match AI_CALLBACK_API_KEY with PDFluent ERP_CALLBACK_API_KEY
AI_CALLBACK_API_KEY=

# disabled (default): Frappe private files only; no MinIO containers or copy.
# auto: local MinIO with automatic bucket, app user and policy; use the internal endpoint.
# manual: existing server/bucket/app keys; no local MinIO server.
# If an existing MinIO runs on this same server, use
# MINIO_ENDPOINT=http://host.docker.internal:9000 and restrict that port.
# Run production through scripts/prod_compose.py so the optional overlay is selected.
MINIO_MODE=disabled
COMPOSE_PROFILES=
MINIO_ENDPOINT=
MINIO_BUCKET=documents

# Keep the application keys stable after installation. Root keys are used only
# by auto mode and are not passed to the application containers.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Host reverse proxy terminates HTTPS and connects here locally.
HTTP_PUBLISH_PORT=127.0.0.1:8080
CLIENT_MAX_BODY_SIZE=200m
PROXY_READ_TIMEOUT=120
