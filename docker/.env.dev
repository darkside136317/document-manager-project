# =============================================================================
# Document Manager — Docker Environment Variables
# =============================================================================
# Copy this file to .env and replace every placeholder before running Docker.
# NEVER commit docker/.env or real credentials to Git.

# --- Frappe/ERPNext ---
ERPNEXT_VERSION=v16.26.2
COMPOSE_PROJECT_NAME=docker
FRAPPE_SITE_NAME=docmanager.local
PUBLIC_URL=http://localhost:8888
DATA_VOLUME_PREFIX=docmanager
ADMIN_PASSWORD=9BdCUT2545eRfMCqNWNoWj7xrffR2OUm

# --- MariaDB ---
DB_HOST=db
DB_PORT=3306
MARIADB_ROOT_PASSWORD=zskiZKvOEeNqviVyK7XpIvrDlQlNG8jA

# --- Redis ---
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# --- Gunicorn ---
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- MongoDB Atlas (GridFS file storage) ---
# Obtain this URI from MongoDB Atlas > Database > Connect > Drivers.
MONGODB_ATLAS_URI=
MONGODB_DATABASE=docmanager_files

# --- Meilisearch ---
MEILISEARCH_MASTER_KEY=A92VXVFZhfGr66W0-w7fHkCmsrnSCKP9ZpJ525KO05U

# --- Nginx ---
HTTP_PUBLISH_PORT=8888
CLIENT_MAX_BODY_SIZE=200m
PROXY_READ_TIMEOUT=120

# --- Optional TLS ---
# LETSENCRYPT_EMAIL=admin@example.com
