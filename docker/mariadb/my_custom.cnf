# =============================================================================
# MariaDB Production Tuning — my_custom.cnf
# =============================================================================
# Mount this file to /etc/mysql/conf.d/my_custom.cnf in the MariaDB container.
# Tuned for archival document workload: many reads, bulk inserts, TEXT fields.
# Assumes 4-8GB RAM server. Adjust values for your hardware.
# =============================================================================

[mysqld]
# --- Character set (required by Frappe) ---
character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci
skip-character-set-client-handshake

# --- InnoDB Engine ---
innodb_buffer_pool_size        = 1G
innodb_buffer_pool_instances   = 2
innodb_log_file_size           = 256M
innodb_log_buffer_size         = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method            = O_DIRECT
innodb_file_per_table          = ON
innodb_io_capacity             = 2000
innodb_io_capacity_max         = 4000
innodb_read_io_threads         = 8
innodb_write_io_threads        = 8

# --- Query Cache (disabled — Frappe uses Redis for caching) ---
query_cache_type               = 0
query_cache_size               = 0

# --- Connections ---
max_connections                = 150
max_allowed_packet             = 256M
wait_timeout                   = 28800
interactive_timeout            = 28800

# --- Temp Tables ---
tmp_table_size                 = 64M
max_heap_table_size            = 64M

# --- Sorting & Joins ---
sort_buffer_size               = 4M
join_buffer_size               = 4M
read_rnd_buffer_size           = 2M

# --- Table Cache ---
table_open_cache               = 2048
table_definition_cache         = 2048

# --- Logging (production: minimal) ---
slow_query_log                 = ON
slow_query_log_file            = /var/log/mysql/slow.log
long_query_time                = 2
log_queries_not_using_indexes  = OFF

# --- Binary Log (for replication/point-in-time recovery) ---
# Uncomment these for production with replication:
# log_bin                      = /var/log/mysql/mariadb-bin
# binlog_format                = ROW
# expire_logs_days             = 7
# max_binlog_size              = 256M

[client]
default-character-set          = utf8mb4
