# =============================================================================
# Document Manager — Docker Environment Variables
# =============================================================================
# Copy this file to .env and replace every placeholder before running Docker.
# NEVER commit docker/.env or real credentials to Git.

# --- Frappe/ERPNext ---
ERPNEXT_VERSION=v16.26.2
FRAPPE_SITE_NAME=docmanager.example.com
ADMIN_PASSWORD=change_me_admin_password

# --- MariaDB ---
DB_HOST=db
DB_PORT=3306
MARIADB_ROOT_PASSWORD=change_me_database_password

# --- Redis ---
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# --- Gunicorn ---
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- MongoDB Atlas (GridFS file storage) ---
# Obtain this URI from MongoDB Atlas > Database > Connect > Drivers.
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DATABASE=docmanager_files

# --- Meilisearch ---
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=change_me_meilisearch_key

# --- Nginx ---
HTTP_PUBLISH_PORT=8888
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120

# --- Optional TLS ---
# LETSENCRYPT_EMAIL=admin@example.com
