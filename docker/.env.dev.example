# =============================================================================
# Document Manager — local development
# =============================================================================
# Copy to .env.dev. Run Compose with --env-file .env.dev.
# Never commit real credentials.

# --- Frappe/ERPNext ---
ERPNEXT_VERSION=v16.26.2
COMPOSE_PROJECT_NAME=docker
FRAPPE_SITE_NAME=docmanager.local
PUBLIC_URL=http://localhost:8888
DATA_VOLUME_PREFIX=docmanager
ADMIN_PASSWORD=change_me_admin_password

# --- MariaDB ---
DB_HOST=db
DB_PORT=3306
MARIADB_ROOT_PASSWORD=change_me_database_password

# --- Redis ---
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# --- Gunicorn ---
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- MongoDB Atlas (GridFS file storage) ---
# Obtain this URI from MongoDB Atlas > Database > Connect > Drivers.
# Empty: use Frappe private files without GridFS.
MONGODB_ATLAS_URI=
MONGODB_DATABASE=docmanager_files

# --- Meilisearch ---
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=change_me_meilisearch_key

# --- Nginx ---
HTTP_PUBLISH_PORT=8888
CLIENT_MAX_BODY_SIZE=200m
PROXY_READ_TIMEOUT=120

