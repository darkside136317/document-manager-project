{
  "name": "Staff Role Profile",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:role",
  "allow_rename": 0,
  "quick_entry": 0,
  "track_changes": 1,
  "title_field": "label",
  "search_fields": "label,description",
  "fields": [
    {
      "fieldname": "role",
      "fieldtype": "Link",
      "label": "Vai trò Frappe",
      "options": "Role",
      "reqd": 1,
      "unique": 1,
      "set_only_once": 1
    },
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Tên nhóm quyền",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "group_label",
      "fieldtype": "Select",
      "label": "Loại",
      "options": "Quản trị\nTác nghiệp",
      "default": "Tác nghiệp",
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Mô tả"
    },
    {
      "fieldname": "is_builtin",
      "fieldtype": "Check",
      "label": "Nhóm có sẵn",
      "read_only": 1
    },
    {
      "fieldname": "is_admin",
      "fieldtype": "Check",
      "label": "Quản trị viên (mọi quyền)",
      "read_only": 1
    },
    {
      "fieldname": "section_capabilities",
      "fieldtype": "Section Break",
      "label": "Chức năng được làm"
    },
    {
      "fieldname": "capabilities",
      "fieldtype": "Table",
      "label": "Chức năng",
      "options": "Staff Role Capability"
    }
  ],
  "permissions": [
    {
      "role": "Document Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
