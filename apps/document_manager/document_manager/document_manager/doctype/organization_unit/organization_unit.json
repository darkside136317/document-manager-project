{
  "name": "Organization Unit",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:unit_name",
  "is_tree": 1,
  "nsm_parent_field": "parent_organization_unit",
  "is_submittable": 0,
  "allow_rename": 1,
  "quick_entry": 1,
  "track_changes": 1,
  "search_fields": "unit_name,head_name",
  "fields": [
    {"fieldname": "unit_name", "fieldtype": "Data", "label": "Tên phòng/đơn vị", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "parent_organization_unit", "fieldtype": "Link", "label": "Đơn vị cấp trên", "options": "Organization Unit", "in_standard_filter": 1},
    {"fieldname": "is_group", "fieldtype": "Check", "label": "Có đơn vị trực thuộc", "read_only": 1, "default": "0"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "display_order", "fieldtype": "Int", "label": "Thứ tự hiển thị", "default": "0", "in_list_view": 1},
    {"fieldname": "is_visible", "fieldtype": "Check", "label": "Hiển thị công khai", "default": "1", "in_list_view": 1, "description": "Bỏ chọn sẽ ẩn cả các đơn vị trực thuộc"},
    {"fieldname": "section_head", "fieldtype": "Section Break", "label": "Người đứng đầu và liên hệ"},
    {"fieldname": "head_name", "fieldtype": "Data", "label": "Người đứng đầu", "in_list_view": 1},
    {"fieldname": "head_position", "fieldtype": "Data", "label": "Chức vụ"},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Điện thoại", "options": "Phone"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "section_description", "fieldtype": "Section Break", "label": "Chức năng, nhiệm vụ"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Mô tả"},
    {"fieldname": "lft", "fieldtype": "Int", "label": "Left", "hidden": 1},
    {"fieldname": "rgt", "fieldtype": "Int", "label": "Right", "hidden": 1},
    {"fieldname": "old_parent", "fieldtype": "Link", "label": "Old Parent", "options": "Organization Unit", "hidden": 1}
  ],
  "permissions": [
    {"role": "Document Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1, "share": 1, "report": 1},
    {"role": "Reading Room Officer", "read": 1},
    {"role": "Archive Leader", "read": 1}
  ],
  "sort_field": "display_order",
  "sort_order": "ASC"
}
