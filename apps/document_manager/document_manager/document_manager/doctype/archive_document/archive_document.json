{
  "name": "Archive Document",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "format:DOC-{######}",
  "is_submittable": 0,
  "allow_rename": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "document_title",
      "fieldtype": "Data",
      "label": "Tiêu đề văn bản",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "bold": 1
    },
    {
      "fieldname": "archival_file",
      "fieldtype": "Link",
      "label": "Hồ sơ lưu trữ",
      "options": "Archival File",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "catalog",
      "fieldtype": "Link",
      "label": "Mục lục tài liệu",
      "options": "Catalog",
      "read_only": 1,
      "fetch_from": "archival_file.catalog"
    },
    {
      "fieldname": "record_group",
      "fieldtype": "Link",
      "label": "Khối tài liệu",
      "options": "Record Group",
      "read_only": 1,
      "fetch_from": "archival_file.record_group"
    },
    {
      "fieldname": "fonds",
      "fieldtype": "Link",
      "label": "Phông lưu trữ",
      "options": "Fonds",
      "read_only": 1,
      "fetch_from": "archival_file.fonds"
    },
    {
      "fieldname": "confidentiality_level",
      "fieldtype": "Link",
      "label": "Mức độ mật",
      "options": "Confidentiality Level",
      "fetch_from": "archival_file.confidentiality_level",
      "in_standard_filter": 1
    },
    {
      "fieldname": "section_file",
      "fieldtype": "Section Break",
      "label": "Tệp tài liệu"
    },
    {
      "fieldname": "file_attachment",
      "fieldtype": "Attach",
      "label": "Tệp đính kèm",
      "description": "PDF, DOCX, XLSX, ảnh scan..."
    },
    {
      "fieldname": "file_type",
      "fieldtype": "Select",
      "label": "Loại tệp",
      "options": "\nPDF\nDOCX\nXLSX\nJPG\nPNG\nTIFF\nKhác",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "file_size_kb",
      "fieldtype": "Float",
      "label": "Kích thước (KB)",
      "read_only": 1,
      "precision": 2
    },
    {
      "fieldname": "column_break_file",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "checksum",
      "fieldtype": "Data",
      "label": "Checksum (SHA-256)",
      "read_only": 1,
      "description": "Tự động tính khi upload"
    },
    {
      "fieldname": "version",
      "fieldtype": "Int",
      "label": "Phiên bản",
      "default": "1",
      "read_only": 1
    },
    {
      "fieldname": "preview_url",
      "fieldtype": "Data",
      "label": "URL Preview",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "section_storage",
      "fieldtype": "Section Break",
      "label": "Lưu trữ & Tìm kiếm"
    },
    {
      "fieldname": "storage_tier",
      "fieldtype": "Select",
      "label": "Tầng lưu trữ",
      "options": "Hot\nCold",
      "default": "Hot",
      "in_standard_filter": 1
    },
    {
      "fieldname": "gridfs_file_id",
      "fieldtype": "Data",
      "label": "GridFS File ID",
      "read_only": 1,
      "hidden": 1,
      "description": "MongoDB Atlas GridFS ObjectId cho file gốc"
    },
    {
      "fieldname": "gridfs_preview_id",
      "fieldtype": "Data",
      "label": "GridFS Preview ID",
      "read_only": 1,
      "hidden": 1,
      "description": "MongoDB Atlas GridFS ObjectId cho file preview"
    },
    {
      "fieldname": "column_break_storage",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "last_accessed",
      "fieldtype": "Datetime",
      "label": "Lần truy cập cuối",
      "read_only": 1
    },
    {
      "fieldname": "search_index_status",
      "fieldtype": "Select",
      "label": "Trạng thái index tìm kiếm",
      "options": "Chưa index\nĐang xử lý\nĐã index\nLỗi",
      "default": "Chưa index",
      "read_only": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "section_content",
      "fieldtype": "Section Break",
      "label": "Nội dung trích xuất",
      "collapsible": 1
    },
    {
      "fieldname": "content_text",
      "fieldtype": "Long Text",
      "label": "Nội dung văn bản (extracted)",
      "read_only": 1,
      "description": "Kết quả extract text từ file, phục vụ full-text search"
    },
    {
      "fieldname": "section_metadata",
      "fieldtype": "Section Break",
      "label": "Thông tin bổ sung",
      "collapsible": 1
    },
    {
      "fieldname": "document_date",
      "fieldtype": "Date",
      "label": "Ngày văn bản"
    },
    {
      "fieldname": "document_number",
      "fieldtype": "Data",
      "label": "Số văn bản"
    },
    {
      "fieldname": "column_break_meta",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "author",
      "fieldtype": "Data",
      "label": "Tác giả/Người ký"
    },
    {
      "fieldname": "page_count",
      "fieldtype": "Int",
      "label": "Số trang"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Mô tả"
    }
  ],
  "permissions": [
    {
      "role": "Document Admin",
      "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1, "import": 1, "share": 1, "report": 1
    },
    {
      "role": "Cataloger",
      "read": 1, "write": 1, "create": 1, "delete": 1
    },
    {
      "role": "Reading Room Officer",
      "read": 1
    },
    {
      "role": "Reader",
      "read": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "document_title",
  "search_fields": "document_title,document_number,archival_file,fonds,file_type"
}
