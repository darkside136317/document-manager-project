{
  "name": "Backup Batch",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "format:BK-{YYYY}{MM}{DD}-{###}",
  "is_submittable": 0,
  "track_changes": 1,
  "quick_entry": 0,
  "fields": [
    {"fieldname": "backup_type", "fieldtype": "Select", "label": "Loại sao lưu", "options": "Cơ sở dữ liệu\nTệp tài liệu\nCả hai", "default": "Cả hai", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Trạng thái", "options": "Đang chờ\nĐang chạy\nThành công\nMột phần\nChưa hỗ trợ\nLỗi\nĐã hủy", "default": "Đang chờ", "in_list_view": 1, "in_standard_filter": 1, "read_only": 1},
    {"fieldname": "trigger", "fieldtype": "Select", "label": "Cách chạy", "options": "Thủ công\nTheo lịch", "default": "Thủ công", "read_only": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "fonds", "fieldtype": "Link", "label": "Phạm vi tệp (phông)", "options": "Fonds", "description": "Để trống để sao lưu tệp của tất cả các phông"},
    {"fieldname": "initiated_by", "fieldtype": "Link", "label": "Người thực hiện", "options": "User", "read_only": 1},
    {"fieldname": "started_at", "fieldtype": "Datetime", "label": "Bắt đầu lúc", "read_only": 1},
    {"fieldname": "completed_at", "fieldtype": "Datetime", "label": "Hoàn thành lúc", "read_only": 1},
    {"fieldname": "section_db", "fieldtype": "Section Break", "label": "Cơ sở dữ liệu"},
    {"fieldname": "backup_path", "fieldtype": "Data", "label": "Tệp sao lưu CSDL", "read_only": 1},
    {"fieldname": "backup_size_mb", "fieldtype": "Float", "label": "Dung lượng (MB)", "read_only": 1},
    {"fieldname": "db_checksum", "fieldtype": "Data", "label": "SHA-256 của tệp CSDL", "read_only": 1},
    {"fieldname": "section_files", "fieldtype": "Section Break", "label": "Tệp tài liệu"},
    {"fieldname": "files_total", "fieldtype": "Int", "label": "Số tệp cần sao lưu", "read_only": 1},
    {"fieldname": "files_done", "fieldtype": "Int", "label": "Đã sao lưu", "read_only": 1},
    {"fieldname": "files_failed", "fieldtype": "Int", "label": "Lỗi", "read_only": 1},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "files_size_mb", "fieldtype": "Float", "label": "Dung lượng tệp (MB)", "read_only": 1},
    {"fieldname": "manifest_path", "fieldtype": "Data", "label": "Bảng kê (manifest)", "read_only": 1},
    {"fieldname": "cursor", "fieldtype": "Data", "label": "Con trỏ tiến độ", "read_only": 1, "hidden": 1},
    {"fieldname": "section_notes", "fieldtype": "Section Break", "label": "Ghi chú"},
    {"fieldname": "expires_on", "fieldtype": "Date", "label": "Giữ đến ngày", "read_only": 1},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Ghi chú"},
    {"fieldname": "error_log", "fieldtype": "Long Text", "label": "Nhật ký lỗi", "read_only": 1}
  ],
  "permissions": [
    {"role": "Document Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "Preservation Officer", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
    {"role": "Archive Leader", "read": 1}
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}
