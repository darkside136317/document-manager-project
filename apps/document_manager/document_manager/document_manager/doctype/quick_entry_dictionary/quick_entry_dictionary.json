{
  "name": "Quick Entry Dictionary",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "format:{dictionary_type}-{entry_value}",
  "is_submittable": 0,
  "allow_rename": 0,
  "quick_entry": 1,
  "track_changes": 0,
  "fields": [
    {
      "fieldname": "dictionary_type",
      "fieldtype": "Data",
      "label": "Loại từ điển",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "VD: Tên người, Địa danh, Chức danh, Cơ quan..."
    },
    {
      "fieldname": "entry_value",
      "fieldtype": "Data",
      "label": "Giá trị",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "parent_entry",
      "fieldtype": "Link",
      "label": "Giá trị cha (từ điển đa cấp)",
      "options": "Quick Entry Dictionary",
      "in_standard_filter": 1,
      "description": "Để trống nếu là từ điển đơn cấp. Chọn giá trị cha nếu là từ điển đa cấp."
    },
    {
      "fieldname": "sort_order",
      "fieldtype": "Int",
      "label": "Thứ tự sắp xếp",
      "default": "0"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Đang sử dụng",
      "default": "1"
    }
  ],
  "permissions": [
    {
      "role": "Document Admin",
      "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1, "import": 1, "share": 1, "report": 1
    },
    {
      "role": "Cataloger",
      "read": 1, "write": 1, "create": 1
    }
  ],
  "sort_field": "dictionary_type",
  "sort_order": "ASC"
}
