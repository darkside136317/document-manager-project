{
  "name": "Data Exchange Job",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "format:XJ-{YYYY}-{#####}",
  "quick_entry": 0,
  "title_field": "file_name",
  "search_fields": "file_name,direction,status",
  "fields": [
    {"fieldname": "direction", "fieldtype": "Select", "label": "Chiều", "options": "Xuất\nNhập", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Tình trạng", "options": "Đã tải lên\nChờ xử lý\nĐang xử lý\nHoàn thành\nHoàn thành có lỗi\nThất bại\nĐã hủy", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "level", "fieldtype": "Select", "label": "Cấp dữ liệu", "options": "\nFonds\nRecord Group\nCatalog\nArchival File\nArchive Document", "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "mode", "fieldtype": "Select", "label": "Cách nhập", "options": "\nChỉ thêm mới\nThêm mới và cập nhật"},
    {"fieldname": "dry_run", "fieldtype": "Check", "label": "Chạy thử (không ghi)"},
    {"fieldname": "create_masters", "fieldtype": "Check", "label": "Tạo danh mục còn thiếu"},
    {"fieldname": "section_file", "fieldtype": "Section Break", "label": "Tệp"},
    {"fieldname": "file_name", "fieldtype": "Data", "label": "Tên tệp"},
    {"fieldname": "source_file", "fieldtype": "Data", "label": "Tệp tải lên", "read_only": 1},
    {"fieldname": "result_file", "fieldtype": "Data", "label": "Tệp kết quả", "read_only": 1},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "file_size_kb", "fieldtype": "Float", "label": "Dung lượng (KB)", "read_only": 1},
    {"fieldname": "checksum", "fieldtype": "Data", "label": "SHA-256", "read_only": 1},
    {"fieldname": "section_progress", "fieldtype": "Section Break", "label": "Tiến độ và kết quả"},
    {"fieldname": "total", "fieldtype": "Int", "label": "Tổng số bản ghi", "read_only": 1},
    {"fieldname": "processed", "fieldtype": "Int", "label": "Đã xử lý", "read_only": 1},
    {"fieldname": "created", "fieldtype": "Int", "label": "Thêm mới", "read_only": 1},
    {"fieldname": "updated", "fieldtype": "Int", "label": "Cập nhật", "read_only": 1},
    {"fieldname": "skipped", "fieldtype": "Int", "label": "Bỏ qua", "read_only": 1},
    {"fieldname": "failed", "fieldtype": "Int", "label": "Lỗi", "read_only": 1},
    {"fieldname": "column_break_3", "fieldtype": "Column Break"},
    {"fieldname": "started_on", "fieldtype": "Datetime", "label": "Bắt đầu", "read_only": 1},
    {"fieldname": "finished_on", "fieldtype": "Datetime", "label": "Kết thúc", "read_only": 1},
    {"fieldname": "summary", "fieldtype": "Small Text", "label": "Tóm tắt", "read_only": 1},
    {"fieldname": "section_data", "fieldtype": "Section Break", "label": "Chi tiết", "collapsible": 1},
    {"fieldname": "options_json", "fieldtype": "Long Text", "label": "Tùy chọn", "read_only": 1},
    {"fieldname": "analysis_json", "fieldtype": "Long Text", "label": "Phân tích tệp", "read_only": 1},
    {"fieldname": "result_json", "fieldtype": "Long Text", "label": "Kết quả theo cấp", "read_only": 1},
    {"fieldname": "rows", "fieldtype": "Table", "label": "Nhật ký lỗi, cảnh báo", "options": "Data Exchange Row", "read_only": 1}
  ],
  "permissions": [
    {"role": "Document Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1}
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}
