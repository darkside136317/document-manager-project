{
  "name": "Reader Registration",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "format:REG-{YYYY}-{#####}",
  "is_submittable": 0,
  "track_changes": 1,
  "title_field": "full_name",
  "search_fields": "full_name,email,phone,organization",
  "fields": [
    {"fieldname": "request_type", "fieldtype": "Select", "label": "Loại yêu cầu", "options": "Đăng ký tài khoản\nQuên mật khẩu", "default": "Đăng ký tài khoản", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "read_only": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Trạng thái", "options": "Mới\nĐã duyệt\nTừ chối", "default": "Mới", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "read_only": 1, "search_index": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "ip_address", "fieldtype": "Data", "label": "Địa chỉ IP", "read_only": 1},
    {"fieldname": "section_person", "fieldtype": "Section Break", "label": "Người đăng ký"},
    {"fieldname": "full_name", "fieldtype": "Data", "label": "Họ và tên", "reqd": 1, "in_list_view": 1},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email", "reqd": 1, "in_list_view": 1, "search_index": 1},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Điện thoại"},
    {"fieldname": "id_number", "fieldtype": "Data", "label": "Số CMND/CCCD"},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "organization", "fieldtype": "Data", "label": "Cơ quan/Đơn vị"},
    {"fieldname": "position", "fieldtype": "Data", "label": "Chức vụ"},
    {"fieldname": "address", "fieldtype": "Small Text", "label": "Địa chỉ"},
    {"fieldname": "purpose", "fieldtype": "Small Text", "label": "Mục đích khai thác"},
    {"fieldname": "section_decision", "fieldtype": "Section Break", "label": "Xử lý"},
    {"fieldname": "reader", "fieldtype": "Link", "label": "Độc giả", "options": "Reader", "read_only": 1},
    {"fieldname": "user", "fieldtype": "Link", "label": "Tài khoản", "options": "User", "read_only": 1},
    {"fieldname": "column_break_3", "fieldtype": "Column Break"},
    {"fieldname": "decided_by", "fieldtype": "Link", "label": "Người xử lý", "options": "User", "read_only": 1},
    {"fieldname": "decided_on", "fieldtype": "Datetime", "label": "Thời điểm xử lý", "read_only": 1},
    {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Lý do từ chối", "read_only": 1}
  ],
  "permissions": [
    {"role": "Document Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1, "report": 1},
    {"role": "Reading Room Officer", "read": 1, "write": 1, "create": 1}
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}
