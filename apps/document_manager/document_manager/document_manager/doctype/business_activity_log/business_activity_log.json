{
  "name": "Business Activity Log", "module": "Document Manager", "doctype": "DocType",
  "document_type": "Document", "engine": "InnoDB",
  "naming_rule": "Expression", "autoname": "format:LOG-{######}",
  "is_submittable": 0, "track_changes": 0, "in_create": 1,
  "fields": [
    {"fieldname": "activity_type", "fieldtype": "Select", "label": "Loại hoạt động", "options": "Tạo mới\nCập nhật\nXóa\nTìm kiếm\nTải xuống\nXuất XML\nNhập XML\nSao lưu\nPhục hồi\nKiểm tra", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "reference_doctype", "fieldtype": "Data", "label": "Doctype", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "reference_name", "fieldtype": "Data", "label": "Tên bản ghi", "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "user", "fieldtype": "Link", "label": "Người thực hiện", "options": "User", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "ip_address", "fieldtype": "Data", "label": "Địa chỉ IP"},
    {"fieldname": "timestamp", "fieldtype": "Datetime", "label": "Thời gian", "default": "Now", "in_list_view": 1},
    {"fieldname": "section_detail", "fieldtype": "Section Break", "label": "Chi tiết"},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Mô tả hoạt động"},
    {"fieldname": "data_json", "fieldtype": "Long Text", "label": "Dữ liệu (JSON)", "hidden": 1}
  ],
  "permissions": [
    {"role": "Document Admin", "read": 1, "write": 0, "create": 1, "delete": 0, "report": 1, "export": 1},
    {"role": "System Manager", "read": 1, "report": 1, "export": 1}
  ],
  "sort_field": "timestamp", "sort_order": "DESC"
}
