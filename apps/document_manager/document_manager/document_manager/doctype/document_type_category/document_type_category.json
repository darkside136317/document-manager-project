{
  "name": "Document Type Category",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:type_name",
  "is_submittable": 0,
  "allow_rename": 1,
  "quick_entry": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "type_name",
      "fieldtype": "Data",
      "label": "Tên loại hình tài liệu",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "type_code",
      "fieldtype": "Data",
      "label": "Mã loại hình",
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Mô tả"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Đang sử dụng",
      "default": "1"
    }
  ],
  "permissions": [
    {
      "role": "Document Admin",
      "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1, "import": 1, "share": 1, "report": 1
    },
    {
      "role": "Cataloger",
      "read": 1, "write": 1, "create": 1
    },
    {
      "role": "Reading Room Officer",
      "read": 1
    }
  ],
  "sort_field": "type_name",
  "sort_order": "ASC"
}
