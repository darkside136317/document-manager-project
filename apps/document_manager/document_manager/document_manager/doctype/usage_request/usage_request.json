{
  "name": "Usage Request",
  "module": "Document Manager",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "format:UR-{YYYY}-{#####}",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "reader", "fieldtype": "Link", "label": "Độc giả", "options": "Reader", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "reader_name", "fieldtype": "Data", "label": "Tên độc giả", "fetch_from": "reader.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "request_date", "fieldtype": "Date", "label": "Ngày yêu cầu", "default": "Today", "reqd": 1, "in_list_view": 1},
    {"fieldname": "purpose", "fieldtype": "Small Text", "label": "Mục đích sử dụng"},
    {"fieldname": "workflow_state", "fieldtype": "Select", "label": "Trạng thái", "options": "Nháp\nChờ duyệt\nĐã duyệt\nTừ chối\nĐã trả", "default": "Nháp", "in_list_view": 1, "in_standard_filter": 1, "read_only": 1, "allow_on_submit": 1},
    {"fieldname": "section_items", "fieldtype": "Section Break", "label": "Danh sách hồ sơ/văn bản yêu cầu"},
    {"fieldname": "items", "fieldtype": "Table", "label": "Hồ sơ/Văn bản", "options": "Usage Request Item", "reqd": 1},
    {"fieldname": "section_approval", "fieldtype": "Section Break", "label": "Phê duyệt", "collapsible": 1},
    {"fieldname": "approved_by", "fieldtype": "Link", "label": "Người duyệt", "options": "User", "read_only": 1},
    {"fieldname": "approved_date", "fieldtype": "Datetime", "label": "Ngày duyệt", "read_only": 1},
    {"fieldname": "column_break_app", "fieldtype": "Column Break"},
    {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Lý do từ chối"},
    {"fieldname": "returned_date", "fieldtype": "Datetime", "label": "Ngày trả tài liệu", "read_only": 1},
    {"fieldname": "section_notes", "fieldtype": "Section Break", "label": "Ghi chú", "collapsible": 1},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Ghi chú"},
    {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "Usage Request", "read_only": 1, "hidden": 1}
  ],
  "permissions": [
    {"role": "Document Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "export": 1, "report": 1},
    {"role": "Reading Room Officer", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1},
    {"role": "Reader", "read": 1, "write": 1, "create": 1, "submit": 1, "if_owner": 1}
  ],
  "sort_field": "modified", "sort_order": "DESC",
  "title_field": "reader_name",
  "search_fields": "reader,reader_name,request_date,workflow_state"
}
